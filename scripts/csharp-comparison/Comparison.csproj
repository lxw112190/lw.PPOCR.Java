<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>LwPpocrComparison</AssemblyName><Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SimdPaddleOcrRoot)/src/Sdcb.SimdPaddleOCR/Sdcb.SimdPaddleOCR.csproj" />
  </ItemGroup>
  <Target Name="ValidateReference" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SimdPaddleOcrRoot)' == ''" Text="Set SimdPaddleOcrRoot to the isolated reference snapshot." />
  </Target>
</Project>
